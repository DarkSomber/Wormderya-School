 */
export const DEFAULT_LETTER_POOL = [
  'A', 'B', 'K', 'D', 'E', 'G', 'H', 'I', 'L',
  'M', 'N', 'O', 'P', 'R', 'S', 'T', 'U', 'W', 'Y',
